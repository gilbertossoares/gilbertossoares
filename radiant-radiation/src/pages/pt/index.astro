---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { BASE, SITE_DESCRIPTION_PT } from '../../consts';

const title = 'Gilberto Santos — IA, Arquitetura de Soluções e Cloud';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead
			title={title}
			description={SITE_DESCRIPTION_PT}
			lang="pt-BR"
			translations={[
				{ hreflang: 'en', href: `${BASE}/` },
				{ hreflang: 'pt-BR', href: `${BASE}/pt/` },
			]}
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<p class="eyebrow">IA • Cloud • Dados • Pesquisa</p>

				<h1>Gilberto Santos</h1>

				<p class="lead">
					Escrevo sobre inteligência artificial, arquitetura de soluções, dados, cloud,
					produtos digitais e experimentos técnicos.
				</p>

				<p>
					Este espaço reúne artigos, projetos, notas de pesquisa, aprendizados e ideias
					em desenvolvimento. É onde publico com mais profundidade do que nas redes sociais.
				</p>

				<div class="actions">
					<a class="button primary" href={`${BASE}/blog/pt/`}>Ler artigos</a>
					<a class="button secondary" href={`${BASE}/about/pt/`}>Sobre mim</a>
				</div>

				<a class="lang-toggle" href={`${BASE}/`}>Read in English</a>
			</section>

			<section class="cards">
				<a class="card" href={`${BASE}/blog/pt/`}>
					<span>Artigos</span>
					<p>Conteúdo técnico sobre IA, LLMs, Azure, dados, arquitetura e engenharia.</p>
				</a>

				<a class="card" href={`${BASE}/projects/pt/`}>
					<span>Projetos</span>
					<p>Experimentos, protótipos, aplicações e ideias que estou construindo ou explorando.</p>
				</a>

				<a class="card" href={`${BASE}/about/pt/`}>
					<span>Sobre</span>
					<p>Minha trajetória, interesses técnicos, palestras, projetos e links.</p>
				</a>
			</section>

			<section>
				<h2>Principais temas</h2>

				<ul class="topics">
					<li>Inteligência Artificial e LLMs</li>
					<li>Azure, dados e arquitetura de soluções</li>
					<li>Agentes, RAG e aplicações práticas de IA</li>
					<li>Computação quântica e aprendizado aplicado</li>
					<li>Projetos pessoais, jogos web e experimentos técnicos</li>
				</ul>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 2rem 0 3rem;
	}

	.eyebrow {
		color: var(--accent);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-size: 0.9rem;
		margin-bottom: 0.5rem;
	}

	.lead {
		font-size: 1.25rem;
		line-height: 1.6;
		color: rgb(var(--black));
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.button {
		display: inline-block;
		padding: 0.75rem 1rem;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 700;
	}

	.button.primary {
		background: var(--accent);
		color: white;
	}

	.button.primary:hover {
		background: var(--accent-dark);
		color: white;
	}

	.button.secondary {
		border: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		background: white;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin: 2rem 0 3rem;
	}

	.card {
		display: block;
		padding: 1.2rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.75);
		box-shadow: var(--box-shadow);
		text-decoration: none;
		color: rgb(var(--gray-dark));
	}

	.card:hover {
		transform: translateY(-2px);
		color: rgb(var(--gray-dark));
	}

	.card span {
		display: block;
		margin-bottom: 0.5rem;
		color: rgb(var(--black));
		font-weight: 700;
		font-size: 1.1rem;
	}

	.card p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.topics {
		display: grid;
		gap: 0.5rem;
		padding-left: 1.2rem;
	}

	@media (max-width: 720px) {
		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
