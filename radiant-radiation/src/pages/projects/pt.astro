---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { BASE } from '../../consts';

const title = 'Projetos';
const description = 'Projetos públicos no GitHub de Gilberto Santos.';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead
			title={title}
			description={description}
			lang="pt-BR"
			translations={[
				{ hreflang: 'en', href: `${BASE}/projects/` },
				{ hreflang: 'pt-BR', href: `${BASE}/projects/pt/` },
			]}
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<p class="eyebrow">GitHub • Experimentos • Código</p>
				<h1>Projetos</h1>
				<p>
					Repositórios públicos, workshops e experimentos técnicos que mantenho no GitHub.
				</p>

				<a class="lang-toggle" href={`${BASE}/projects/`}>Read in English</a>
			</section>

			<section class="project-list">
				<article class="project-card">
					<div>
						<p class="status">Projeto público</p>
						<h2>Anonimizer</h2>
						<p>
							Uma aplicação de anonimização de documentos construída com serviços do Azure AI,
							focada em detectar e remover informações de identificação pessoal (PII). Inclui
							upload de documentos, processamento e uma interface web.
						</p>
						<p class="tags">Azure AI • PII • Python • Flask • Documents</p>
					</div>

					<a href="https://github.com/gilbertossoares/anonimizer" target="_blank" rel="noopener noreferrer">
						Ver no GitHub →
					</a>
				</article>

				<article class="project-card">
					<div>
						<p class="status">Workshop</p>
						<h2>Azure AI Foundry Workshop</h2>
						<p>
							Um workshop prático com laboratórios e exemplos de código para explorar o Azure
							AI Foundry, Azure OpenAI, serviços de IA, engenharia de prompt, Semantic Kernel,
							AutoGen e RAG com Azure AI Search.
						</p>
						<p class="tags">Azure AI Foundry • Azure OpenAI • RAG • Agents • Workshop</p>
					</div>

					<a href="https://github.com/gilbertossoares/ai-foundry-workshop" target="_blank" rel="noopener noreferrer">
						Ver no GitHub →
					</a>
				</article>

				<article class="project-card">
					<div>
						<p class="status">Benchmark</p>
						<h2>Vector Azure Benchmark</h2>
						<p>
							Um conjunto de benchmarks para comparar performance de busca vetorial entre
							plataformas como Azure, Databricks e Microsoft Fabric, medindo latência,
							throughput, consistência e métricas como P95 e P99.
						</p>
						<p class="tags">Vector Search • Azure • Databricks • Microsoft Fabric • Benchmark</p>
					</div>

					<a href="https://github.com/gilbertossoares/demo-vector-benchmark" target="_blank" rel="noopener noreferrer">
						Ver no GitHub →
					</a>
				</article>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.hero {
		margin-bottom: 2.5rem;
	}

	.eyebrow {
		color: var(--accent);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		font-size: 0.9rem;
		margin-bottom: 0.5rem;
	}

	.hero p:last-of-type {
		font-size: 1.15rem;
		color: rgb(var(--gray));
	}

	.project-list {
		display: grid;
		gap: 1.25rem;
	}

	.project-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.78);
		box-shadow: var(--box-shadow);
	}

	.project-card h2 {
		margin-top: 0;
		margin-bottom: 0.75rem;
		font-size: 1.6rem;
	}

	.project-card p {
		margin-bottom: 0.75rem;
	}

	.project-card a {
		width: fit-content;
		font-weight: 700;
		text-decoration: none;
	}

	.status {
		margin-bottom: 0.5rem;
		color: var(--accent);
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.tags {
		color: rgb(var(--gray));
		font-size: 0.95rem;
		font-weight: 700;
	}
</style>
